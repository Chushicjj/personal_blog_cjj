# =============================================================
# 环境变量模板（复制成 .env 后按实际情况填写）
# 说明：真实 .env 不提交、不进镜像，容器内由 docker-compose 注入
# =============================================================

# ---------- 服务 ----------
# 服务器上一律 production；本地调试可以改 development。
# 它决定 Cookie 是否加 Secure、是否发 HSTS —— 上 HTTPS 之后再改就晚了。
NODE_ENV=production
SERVER_PORT=3000

# ---------- 数据库（沿用现有 MySQL 8.0 的 blog 库） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=blog_user
# 密码含空格、#、$ 等字符时整体加引号，否则 dotenv 会把 # 之后当注释、把空格原样保留
DB_PASSWORD="change_me"
DB_NAME=blog
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10000
# 数据库会话时区（只接受 +08:00 这类数字偏移或 UTC），保证 NOW() 与业务时间字段口径一致
DB_TIMEZONE=+08:00

# ---------- 日志 ----------
# debug | info | warn | error
LOG_LEVEL=info
# true 时同时写文件（目录由 LOG_DIR 指定），容器里配合 ./logs 挂载
LOG_TO_FILE=false
LOG_DIR=logs

# ---------- 上传 ----------
# 视频等大文件落磁盘的根目录（图片仍然存数据库）
# 容器里建议设成 /app/data/uploads，并把宿主机目录挂到 /app/data
UPLOAD_DIR=data/uploads
# 单个视频体积上限（MB），超限直接 400，不写盘
VIDEO_MAX_MB=100

# ---------- 可选 ----------
APP_VERSION=1.0.0
